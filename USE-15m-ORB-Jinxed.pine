// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © fluxchart
// Modified for PickMyTrade: separate Buy/Sell/TP1/TP2/TP3/SL alert conditions + hidden SL & TP1 plots
// v7: Fixed missing TP3 Avg Gain row, table bumped to 15 rows
// v8: Real-time touch entry — Buy/Sell alert fires the moment price retests the ORB level
//     after a confirmed breakout, instead of waiting for the retest candle to close.
// v9: Entry Trigger dropdown. 'Instant Level Break' makes Buy/Sell work exactly like the
//     SL/TP alerts: fires the moment price touches the ORB level, any time inside the
//     candle. Entry price is the level itself, so SL/TP track from the level too.
//     Also adds SL-style X markers on the chart at the entry bar.
// v10: Smart ORB (liquidity + value area). Skips breakouts toward nearby unswept
//      swing-point liquidity (fakeout filter), trades the reversal after a liquidity
//      sweep + candle close back inside the opening-range value area, and takes
//      breakouts on a candle close outside the value area when the path is clear.
//      SL: reversal = beyond the trigger candle; breakout = 2 ticks past the POC.
//      TP targets (ATR multipliers / Dynamic) are unchanged. ORB default now 15m.
// v11: Jay-style rules take priority. New 'Trend Candle' stop-loss (default): SL just
//      beyond the 5-min candle that closed beyond the ORB level. New ORB Reversal:
//      a breakout that extends, fails, and closes back inside the range enters the
//      opposite direction with SL beyond the failed side (min-extension ATR filter).
//      Optional ORB midline line (off by default). TP targets still unchanged.

//@version=6
indicator('USE | 15m ORB | Jinxed', overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500, max_bars_back = 5000)

const bool DEBUG = false
int maxBarsBack = last_bar_index
int renderMaxBarsBack = 5000
const float minimumProfitPercent = 0.20
const float minimumProfitIncrementPercent = 0.075
const float stopLossPercent = 1.0

const float atrTP1Mult = 0.75
const float atrTP2Mult = 1.5
const float atrTP3Mult = 2.25
const float atrTotalMult = 1.0

orbTimeStr = input.timeframe('15', 'ORB Timeframe', group = 'Algorithm', display = display.none)
sensitivity = input.string('Medium', 'Sensitivity', options = ['High', 'Medium', 'Low', 'Lowest'], group = 'Algorithm', display = display.none)
breakoutCondition = input.string('Close', 'Breakout Condition', options = ['Close', 'EMA'], group = 'Algorithm', display = display.none)
entryTrigger = input.string('Retest of Level', 'Entry Trigger', options = ['Candle Close', 'Retest of Level', 'Instant Level Break'], group = 'Algorithm', tooltip = 'How the Buy/Sell alert fires. INSTANT LEVEL BREAK: works exactly like the SL/TP alerts — fires the moment price touches the ORB level, any time inside the candle, no close needed. Entry price is the level itself and the Sensitivity retest count is ignored. RETEST OF LEVEL: a candle must first close beyond the level, then the alert fires the moment price pulls back and touches it. CANDLE CLOSE: original behaviour — waits for the breakout/retest candle to close. Instant/Retest modes use the TP/SL Alert Buffer as the trigger distance.', display = display.none)
tpMethod = input.string('ATR', 'TP Method', options = ['Dynamic', 'ATR'], group = 'Algorithm', display = display.none)
emaLength = input.int(9, 'EMA Length', options = [4, 9, 13, 20, 34], group = 'Algorithm', display = display.none)
slMethod = input.string('Trend Candle', 'Stop-Loss', options = ['Trend Candle', 'Safer', 'Balanced', 'Risky'], group = 'Algorithm', tooltip = 'TREND CANDLE: stop just beyond the 5-min candle that closed beyond the ORB level (the trend-setting candle). SAFER/BALANCED/RISKY: range-based — Balanced is the ORB midline. Instant Level Break entries have no trend-setting candle, so Trend Candle falls back to the midline there.', display = display.none)
adaptiveSL = input.bool(false, 'Adaptive SL', group = 'Algorithm', display = display.none)
orbReversalEnabled = input.bool(true, 'ORB Reversal Entries', group = 'Algorithm', tooltip = 'After a confirmed breakout (5-min close beyond the ORB level) EXTENDS and then FAILS — a candle closes back inside the range — enter in the opposite direction. Stop goes just beyond the failed side (the ORB level or the failure candle extreme, whichever is further). Only fires if no entry was taken yet this session. Works with the Candle Close and Retest of Level entry triggers.')
revMinExtATR = input.float(0.5, 'Reversal Min Break (ATR)', minval = 0.0, maxval = 5, step = 0.25, group = 'Algorithm', tooltip = 'The failed breakout must have pushed at least this many ATRs beyond the ORB level for the reversal entry to be valid — filters out tiny pokes above/below the range.')

smartOrbEnabled = input.bool(false, 'Enable Smart ORB Logic', group = 'Smart ORB (Liquidity + Value Area)', tooltip = 'Trades the ORB around liquidity and the opening-range value area instead of raw range breaks. FAKEOUT FILTER: a swing point resting just outside the range blocks breakouts toward it. REVERSAL: after that liquidity is swept, a candle close back inside the value area enters against the sweep (SL just beyond the trigger candle). BREAKOUT: on a side with no nearby liquidity, enters on a candle close outside the value area (SL 2 ticks past the POC). TP targets are untouched. Entries are candle-close based, so this overrides the Entry Trigger setting.')
liqPivotLen = input.int(1, 'Swing Point Strength', minval = 1, maxval = 10, group = 'Smart ORB (Liquidity + Value Area)', tooltip = '1 = a candle with a higher high (or lower low) than the single candle on each side of it.')
liqLookback = input.int(200, 'Liquidity Lookback (bars)', minval = 20, maxval = 500, group = 'Smart ORB (Liquidity + Value Area)')
liqProximityATR = input.float(2.0, 'Liquidity Proximity (ATR)', minval = 0.5, maxval = 10, step = 0.5, group = 'Smart ORB (Liquidity + Value Area)', tooltip = 'A swing point within this many ATRs outside the opening range counts as nearby liquidity: breakouts toward it are skipped and a reversal setup is armed instead.')
vaPercent = input.float(70, 'Value Area %', minval = 50, maxval = 95, group = 'Smart ORB (Liquidity + Value Area)')
breakoutLevel = input.string('Value Area', 'Breakout Entry Level', options = ['Value Area', 'ORB High/Low'], group = 'Smart ORB (Liquidity + Value Area)', tooltip = 'Which level a candle must close beyond for a breakout entry. Value Area (VAH/VAL) enters earlier; ORB High/Low is the classic, more conservative break.')
showVALines = input.bool(false, 'Show Value Area Lines (blue)', group = 'Smart ORB (Liquidity + Value Area)', tooltip = 'VAH and VAL — the edges of the zone where 70% of the opening range volume traded.')
showPOCLine = input.bool(false, 'Show POC Line (red)', group = 'Smart ORB (Liquidity + Value Area)', tooltip = 'The single price level with the most traded volume in the opening range.')
showLiqLines = input.bool(false, 'Show Liquidity Levels (orange dotted)', group = 'Smart ORB (Liquidity + Value Area)', tooltip = 'The nearest unswept swing point just outside the range — the level the fakeout/reversal logic watches.')

customSessionEnabled = input.bool(true, 'Enabled', group = 'Custom Session', display = display.none)
customSessionTime = input.session('0830-1600', 'Session', group = 'Custom Session', display = display.none)

useVolFilter = input.bool(false, 'High Volume Entry Filter', group = 'Volume Settings', tooltip = 'If enabled, breakouts will only trigger an entry if the current volume is above its 20-period SMA.')
showVP       = input.bool(true, 'Show Volume Profile', group = 'Volume Settings', tooltip = 'Displays a volume profile for the opening range session.')
vpRows       = input.int(14, 'Profile Rows', minval = 5, maxval = 50, group = 'Volume Settings')
vpColor      = input.color(color.new(#5b9cf6, 60), 'Profile Color', group = 'Volume Settings')

useAlertWindow = input.bool(true, 'Only Alert During Specific Hours', group = 'Alert Settings', tooltip = 'If enabled, alerts will only trigger during the hours specified below.')
alertWindow    = input.session('0830-1400:1234567', 'Alert Window Hours', group = 'Alert Settings')
showWindowBg   = input.bool(false, 'Highlight Alert Window on Chart', group = 'Alert Settings')
tpSlBuffer     = input.float(0.25, 'TP/SL Alert Buffer (points)', options = [0.0, 0.25, 0.50, 0.75, 1.0], group = 'Alert Settings', tooltip = 'How close price needs to get to TP or SL to trigger the alert. 0.25 means alert fires when price is within 0.25 points of the level. Also used by the real-time touch entry.')

orbDisplayEnabled = input.bool(true, 'Enabled', group = 'ORB Dashboard', display = display.none)
orbLocation = input.string('Top Center', 'Position', options = ['Top Right', 'Right Center', 'Top Center'], group = 'ORB Dashboard', display = display.none)

backtestDisplayEnabled = input.bool(true, 'Enabled', group = 'Backtesting', display = display.none)
backtestingLocation = input.string('Right Center', 'Position', options = ['Top Right', 'Right Center', 'Top Center'], group = 'Backtesting', display = display.none)
backtestingExitRatios = input.string('75% | 15% | 10%', 'Backtesting Exit Ratios', ['75% | 15% | 10%', '50% | 25% | 25%', '34% | 33% | 33%', '90% | 5% | 5%', '100% | 0% | 0%', '0% | 100% | 0%', '0% | 0% | 100%'], tooltip = 'TP 1 | TP 2 | TP 3', group = 'Backtesting', display = display.none)

showORBZones = input.bool(true, 'Draw ORB Zones', group = 'Visuals', display = display.none, inline = 'group1')
plotEMA = input.bool(false, 'Plot EMA', group = 'Visuals', display = display.none, inline = 'group1')
showMidline = input.bool(false, 'Show ORB Midline', group = 'Visuals', display = display.none, tooltip = 'Dashed gray line at the 50% level of the opening range.')
showHistoricZones = DEBUG ? input.bool(true, 'Show Historic Zones', group = 'Visuals', display = display.none) : true

highColor = input.color(color.green, 'High', inline = 'colors', group = 'Visuals')
lowColor = input.color(color.red, 'Low', inline = 'colors', group = 'Visuals')

isInAlertWindow = not na(time(timeframe.period, alertWindow, syminfo.timezone))
bgcolor(showWindowBg and isInAlertWindow ? color.new(color.blue, 95) : na, title = "Alert Window Background")

var int lastSessionBarIndex = na
if isInAlertWindow
    lastSessionBarIndex := bar_index

volSMA = ta.sma(volume, 20)
isHV = volume > volSMA
var map<float, float> volMap = map.new<float, float>()
var box[] vpBoxes = array.new_box()

float backtestTP1Exit = 0.0
float backtestTP2Exit = 0.0
float backtestTP3Exit = 0.0

backtestTP1Exit := str.tonumber(str.replace(array.get(str.split(backtestingExitRatios, ' | '), 0), '%', '')) / 100.0
backtestTP2Exit := str.tonumber(str.replace(array.get(str.split(backtestingExitRatios, ' | '), 1), '%', '')) / 100.0
backtestTP3Exit := str.tonumber(str.replace(array.get(str.split(backtestingExitRatios, ' | '), 2), '%', '')) / 100.0

retestsNeededForEntry = sensitivity == 'High' ? 0 : sensitivity == 'Medium' ? 1 : sensitivity == 'Low' ? 2 : 3

if timeframe.in_seconds() > timeframe.in_seconds('15')
    runtime.error('ORB Algo only works on timeframes lower than 15 min.')

type Breakout
    bool isBullish
    int startIndex
    int endIndex
    bool failed = false
    int retests = 0

type ORB
    float h
    float l
    int startTime
    int startIndex
    int endIndex
    bool isLastSession
    string state = 'Opening Range'
    array<Breakout> breakouts
    bool foundEntryTick = false
    bool entryBullish
    int entryIndex
    float entryPrice
    float entryATR
    int tp1Index
    float tp1Price
    bool tp1FoundTick = false
    int tp2Index
    float tp2Price
    bool tp2FoundTick = false
    int tp3Index
    float tp3Price
    bool tp3FoundTick = false
    int slIndex
    float slPrice
    bool slFoundTick = false
    bool isExitTrade = false
    bool exitTradeFoundTick = false
    float vah
    float val
    float poc
    float liqAbove
    float liqBelow
    bool sweptAbove = false
    bool sweptBelow = false
    string setupType = ''
    float trendCandleHi
    float trendCandleLo
    float breakoutExt
    line hLine
    line lLine
    line midLine
    line vahLine
    line valLine
    line pocLine
    line liqAboveLine
    line liqBelowLine
    label entryLabel

getPosition(positionText) =>
    if positionText == 'Top Right'
        position.top_right
    else if positionText == 'Top Center'
        position.top_center
    else if positionText == 'Right Center'
        position.middle_right
    else
        position.middle_left

createORB(float h, float l, int sT, int sI, int eI) =>
    newORB = ORB.new(h, l, sT, sI, eI)
    newORB.breakouts := array.new<Breakout>(0)
    newORB

safeDeleteORB(ORB orb) =>
    line.delete(orb.hLine)
    line.delete(orb.lLine)
    line.delete(orb.midLine)
    line.delete(orb.vahLine)
    line.delete(orb.valLine)
    line.delete(orb.pocLine)
    line.delete(orb.liqAboveLine)
    line.delete(orb.liqBelowLine)
    label.delete(orb.entryLabel)

orbColor = #3b3b3b43
var orbList = array.new<ORB>(0)

ema = ta.ema((high + low) / 2.0, emaLength)
atr = ta.atr(12)
plot(plotEMA ? ema : na)

// Smart ORB: swing-point (liquidity) detection — computed globally for series consistency
float pivH = ta.pivothigh(liqPivotLen, liqPivotLen)
float pivL = ta.pivotlow(liqPivotLen, liqPivotLen)
var float[] liqHighs = array.new_float()
var int[] liqHighBars = array.new_int()
var float[] liqLows = array.new_float()
var int[] liqLowBars = array.new_int()

diffPercent(float val1, float val2) =>
    math.abs(val1 - val2) / val2 * 100.0

renderORB(ORB orb) =>
    if orb.startIndex > last_bar_index - renderMaxBarsBack
        int lineEndIndex = nz(orb.endIndex, lastSessionBarIndex)
        if showORBZones
            orb.hLine := line.new(orb.startIndex, orb.h, lineEndIndex, orb.h, color = highColor, width = 2)
            orb.lLine := line.new(orb.startIndex, orb.l, lineEndIndex, orb.l, color = lowColor, width = 2)
        if showMidline
            orb.midLine := line.new(orb.startIndex, (orb.h + orb.l) / 2.0, lineEndIndex, (orb.h + orb.l) / 2.0, color = color.new(color.gray, 30), width = 1, style = line.style_dashed)
        if showVALines and not na(orb.vah)
            orb.vahLine := line.new(orb.startIndex, orb.vah, lineEndIndex, orb.vah, color = color.new(color.blue, 20), width = 1)
            orb.valLine := line.new(orb.startIndex, orb.val, lineEndIndex, orb.val, color = color.new(color.blue, 20), width = 1)
        if showPOCLine and not na(orb.poc)
            orb.pocLine := line.new(orb.startIndex, orb.poc, lineEndIndex, orb.poc, color = color.new(color.red, 20), width = 1)
        if showLiqLines
            if not na(orb.liqAbove)
                orb.liqAboveLine := line.new(orb.startIndex, orb.liqAbove, lineEndIndex, orb.liqAbove, color = color.orange, width = 1, style = line.style_dashed)
            if not na(orb.liqBelow)
                orb.liqBelowLine := line.new(orb.startIndex, orb.liqBelow, lineEndIndex, orb.liqBelow, color = color.orange, width = 1, style = line.style_dashed)
        if not na(orb.entryIndex)
            orb.entryLabel := label.new(orb.entryIndex, orb.entryPrice + orb.entryATR * 3 * (orb.entryBullish ? -1 : 1), orb.entryBullish ? 'Buy' : 'Sell', color = orb.entryBullish ? color.green : color.red, textcolor = color.white, style = orb.entryBullish ? label.style_label_up : label.style_label_down)

ORB lastORB = na
ORB previousORB = na
if orbList.size() > 0
    lastORB := orbList.get(0)
    lastORB.tp1FoundTick := false
    lastORB.tp2FoundTick := false
    lastORB.tp3FoundTick := false
    lastORB.slFoundTick := false
    lastORB.foundEntryTick := false
    lastORB.exitTradeFoundTick := false
    lastORB.isLastSession := last_bar_time - time < 60 * 60 * 8 * 1000

sessionBegins(sess) =>
    t = time('1440', sess)
    na(t[1]) and not na(t) or t[1] < t

sessionEnds(sess) =>
    t = time('1440', sess)
    not na(t[1]) and (na(t) or t[1] < t)

lastClose = close[1]
if barstate.isconfirmed and last_bar_index - bar_index < maxBarsBack
    isNewSession = not customSessionEnabled and session.isfirstbar_regular or customSessionEnabled and sessionBegins(customSessionTime)
    isEndOfSession = not customSessionEnabled and session.islastbar_regular or customSessionEnabled and sessionEnds(customSessionTime)

    // ── Smart ORB: maintain the pool of UNSWEPT swing-point liquidity ──
    // A swing high is removed once price trades through it (it's been swept), so
    // liquidity that was already taken before the ORB formed never blocks a breakout.
    if smartOrbEnabled
        if not na(pivH)
            liqHighs.unshift(pivH)
            liqHighBars.unshift(bar_index - liqPivotLen)
        if not na(pivL)
            liqLows.unshift(pivL)
            liqLowBars.unshift(bar_index - liqPivotLen)
        int liH = liqHighs.size() - 1
        while liH >= 0
            if high > liqHighs.get(liH) or bar_index - liqHighBars.get(liH) > liqLookback
                liqHighs.remove(liH)
                liqHighBars.remove(liH)
            liH -= 1
        int liL = liqLows.size() - 1
        while liL >= 0
            if low < liqLows.get(liL) or bar_index - liqLowBars.get(liL) > liqLookback
                liqLows.remove(liL)
                liqLowBars.remove(liL)
            liL -= 1

    if isNewSession
        newORB = createORB(na, na, time, bar_index, na)
        orbList.unshift(newORB)
        lastORB := orbList.get(0)
        volMap.clear()

    if not na(lastORB) and na(lastORB.endIndex)
        bool forceStop = false
        if useAlertWindow
            if not isInAlertWindow
                forceStop := true
        else if isEndOfSession
            forceStop := true
        if forceStop
            lastORB.endIndex := bar_index
            if not na(lastORB.entryIndex) and na(lastORB.slIndex)
                lastORB.slPrice := close
                lastORB.slIndex := bar_index
                lastORB.exitTradeFoundTick := true
                previousORB := lastORB

    if not na(lastORB) and na(lastORB.endIndex)
        if lastORB.state == 'Opening Range' and time < lastORB.startTime + timeframe.in_seconds(orbTimeStr) * 1000
            lastORB.h := math.max(nz(lastORB.h, 0), high)
            lastORB.l := math.min(nz(lastORB.l, low), low)
            float dynamicTickSize = math.max(syminfo.mintick, (nz(lastORB.h, high) - nz(lastORB.l, low)) / vpRows)
            float level = math.round(close / dynamicTickSize) * dynamicTickSize
            volMap.put(level, (volMap.contains(level) ? volMap.get(level) : 0) + volume)
        if lastORB.state == 'Opening Range' and time >= lastORB.startTime + timeframe.in_seconds(orbTimeStr) * 1000
            lastORB.state := 'Waiting For Breakouts'
            if smartOrbEnabled
                // Value area (VAH / VAL / POC) of the opening-range volume profile:
                // start at the highest-volume level and expand toward the higher-volume
                // neighbour until vaPercent% of the range's volume is covered.
                if volMap.size() > 0
                    float[] vaLevels = volMap.keys()
                    vaLevels.sort()
                    int vaN = vaLevels.size()
                    float[] vaVols = array.new_float()
                    float vaTotal = 0.0
                    float vaPocVol = 0.0
                    int vaPocIdx = 0
                    for vi = 0 to vaN - 1
                        float vv = volMap.get(vaLevels.get(vi))
                        vaVols.push(vv)
                        vaTotal += vv
                        if vv > vaPocVol
                            vaPocVol := vv
                            vaPocIdx := vi
                    int vaUp = vaPocIdx
                    int vaDn = vaPocIdx
                    float vaAcc = vaPocVol
                    while vaAcc < vaTotal * vaPercent / 100.0 and (vaUp < vaN - 1 or vaDn > 0)
                        float vU = vaUp < vaN - 1 ? vaVols.get(vaUp + 1) : -1.0
                        float vD = vaDn > 0 ? vaVols.get(vaDn - 1) : -1.0
                        if vU >= vD
                            vaUp += 1
                            vaAcc += vU
                        else
                            vaDn -= 1
                            vaAcc += vD
                    lastORB.poc := vaLevels.get(vaPocIdx)
                    lastORB.vah := vaLevels.get(vaUp)
                    lastORB.val := vaLevels.get(vaDn)
                // Nearest unswept swing point resting just outside the range
                float bestAbove = na
                if liqHighs.size() > 0
                    for li2 = 0 to liqHighs.size() - 1
                        float lvlH = liqHighs.get(li2)
                        if lvlH > lastORB.h and lvlH <= lastORB.h + atr * liqProximityATR
                            if na(bestAbove) or lvlH < bestAbove
                                bestAbove := lvlH
                float bestBelow = na
                if liqLows.size() > 0
                    for li3 = 0 to liqLows.size() - 1
                        float lvlL = liqLows.get(li3)
                        if lvlL < lastORB.l and lvlL >= lastORB.l - atr * liqProximityATR
                            if na(bestBelow) or lvlL > bestBelow
                                bestBelow := lvlL
                lastORB.liqAbove := bestAbove
                lastORB.liqBelow := bestBelow

    if not na(lastORB) and na(lastORB.endIndex)
        if lastORB.state == 'Waiting For Breakouts'
            if smartOrbEnabled
                float vaTop = na(lastORB.vah) ? lastORB.h : lastORB.vah
                float vaBot = na(lastORB.val) ? lastORB.l : lastORB.val
                float longLevel = breakoutLevel == 'Value Area' ? vaTop : lastORB.h
                float shortLevel = breakoutLevel == 'Value Area' ? vaBot : lastORB.l
                // Track liquidity sweeps
                if not na(lastORB.liqAbove) and high >= lastORB.liqAbove
                    lastORB.sweptAbove := true
                if not na(lastORB.liqBelow) and low <= lastORB.liqBelow
                    lastORB.sweptBelow := true
                bool smartEntry = false
                bool smartBull = false
                string smartType = ''
                float smartSL = na
                // 1) REVERSAL (fakeout) — liquidity swept, candle closes back inside the
                //    value area: enter against the sweep, SL just beyond the trigger candle.
                if lastORB.sweptAbove and close < vaTop
                    smartEntry := true
                    smartBull := false
                    smartType := 'Rev'
                    smartSL := high + syminfo.mintick * 2
                else if lastORB.sweptBelow and close > vaBot
                    smartEntry := true
                    smartBull := true
                    smartType := 'Rev'
                    smartSL := low - syminfo.mintick * 2
                // 2) BREAKOUT — only on a side with NO nearby unswept liquidity:
                //    candle close beyond the entry level, SL 2 ticks past the POC.
                else if na(lastORB.liqAbove) and close > longLevel
                    smartEntry := true
                    smartBull := true
                    smartType := 'BO'
                    smartSL := (na(lastORB.poc) ? (lastORB.h + lastORB.l) / 2.0 : lastORB.poc) - syminfo.mintick * 2
                else if na(lastORB.liqBelow) and close < shortLevel
                    smartEntry := true
                    smartBull := false
                    smartType := 'BO'
                    smartSL := (na(lastORB.poc) ? (lastORB.h + lastORB.l) / 2.0 : lastORB.poc) + syminfo.mintick * 2
                smartVolOK = not useVolFilter or isHV
                if smartEntry and smartVolOK
                    newBreakout = Breakout.new(smartBull, bar_index, bar_index)
                    lastORB.breakouts.unshift(newBreakout)
                    lastORB.state := 'Entry Taken'
                    lastORB.entryATR := atr
                    lastORB.foundEntryTick := true
                    lastORB.entryIndex := bar_index
                    lastORB.entryPrice := close
                    lastORB.entryBullish := smartBull
                    lastORB.setupType := smartType
                    lastORB.slPrice := smartSL
            else if entryTrigger == 'Instant Level Break'
                // Entry works like the SL: the level touch itself is the trigger.
                // Entry price is the ORB level, not the candle close.
                instVolOK = not useVolFilter or isHV
                if instVolOK and (high >= lastORB.h or low <= lastORB.l)
                    bool instBullish = high >= lastORB.h
                    newBreakout = Breakout.new(instBullish, bar_index, bar_index)
                    lastORB.breakouts.unshift(newBreakout)
                    lastORB.state := 'Entry Taken'
                    lastORB.entryATR := atr
                    lastORB.foundEntryTick := true
                    lastORB.entryIndex := bar_index
                    lastORB.entryPrice := instBullish ? lastORB.h : lastORB.l
                    lastORB.entryBullish := instBullish
                    if slMethod == 'Fixed'
                        lastORB.slPrice := lastORB.entryBullish ? lastORB.entryPrice * ((100.0 - stopLossPercent) / 100.0) : lastORB.entryPrice * ((100.0 + stopLossPercent) / 100.0)
                    instCenter = (lastORB.h + lastORB.l) / 2.0
                    if slMethod == 'Trend Candle'
                        // No trend-setting candle exists on an instant touch — fall back to the midline
                        lastORB.slPrice := instCenter
                    if slMethod == 'Safer'
                        lastORB.slPrice := lastORB.entryBullish ? (instCenter + lastORB.h) / 2.0 : (instCenter + lastORB.l) / 2.0
                    if slMethod == 'Balanced'
                        lastORB.slPrice := instCenter
                    if slMethod == 'Risky'
                        lastORB.slPrice := lastORB.entryBullish ? (instCenter + lastORB.l) / 2.0 : (instCenter + lastORB.h) / 2.0
            else
                conditionPrice = breakoutCondition == 'EMA' ? ema : close
                if conditionPrice > lastORB.h or conditionPrice < lastORB.l
                    bool boBull = conditionPrice > lastORB.h
                    newBreakout = Breakout.new(boBull, bar_index, na)
                    lastORB.breakouts.unshift(newBreakout)
                    lastORB.state := 'In Breakout'
                    // Trend-setting candle = the 5-min candle that closed beyond the level.
                    // Its extreme is the 'Trend Candle' stop, and breakoutExt tracks how far
                    // the breakout ran beyond the level (used by the reversal filter).
                    lastORB.trendCandleHi := high
                    lastORB.trendCandleLo := low
                    lastORB.breakoutExt := boBull ? high - lastORB.h : lastORB.l - low

    if not na(lastORB) and na(lastORB.endIndex)
        if lastORB.state == 'In Breakout'
            curBreakout = lastORB.breakouts.get(0)
            if curBreakout.isBullish
                lastORB.breakoutExt := math.max(nz(lastORB.breakoutExt), high - lastORB.h)
            else
                lastORB.breakoutExt := math.max(nz(lastORB.breakoutExt), lastORB.l - low)
            if curBreakout.isBullish and close < lastORB.h or not curBreakout.isBullish and close > lastORB.l
                curBreakout.failed := true
                curBreakout.endIndex := bar_index
                lastORB.state := 'Waiting For Breakouts'
                // ORB REVERSAL: a breakout that extended beyond the level, failed, and
                // closed back inside the range trades the other way. Stop just beyond
                // the failed side (ORB level or failure-candle extreme, whichever is further).
                if orbReversalEnabled and na(lastORB.entryIndex) and nz(lastORB.breakoutExt) >= atr * revMinExtATR and (not useVolFilter or isHV)
                    bool revBull = not curBreakout.isBullish
                    lastORB.state := 'Entry Taken'
                    lastORB.entryATR := atr
                    lastORB.foundEntryTick := true
                    lastORB.entryIndex := bar_index
                    lastORB.entryPrice := close
                    lastORB.entryBullish := revBull
                    lastORB.setupType := 'Rev'
                    lastORB.slPrice := revBull ? math.min(lastORB.l, low) - syminfo.mintick * 2 : math.max(lastORB.h, high) + syminfo.mintick * 2
            if bar_index > curBreakout.startIndex and (curBreakout.isBullish and close > lastORB.h and low < lastORB.h or not curBreakout.isBullish and close < lastORB.l and high > lastORB.l)
                curBreakout.retests := curBreakout.retests + 1
            volCondition = not useVolFilter or isHV
            if lastORB.state == 'In Breakout' and curBreakout.retests >= retestsNeededForEntry and volCondition
                curBreakout.endIndex := bar_index
                lastORB.state := 'Entry Taken'
                lastORB.entryATR := atr
                lastORB.foundEntryTick := true
                lastORB.entryIndex := bar_index
                lastORB.entryPrice := close
                lastORB.entryBullish := curBreakout.isBullish
                if slMethod == 'Fixed'
                    lastORB.slPrice := lastORB.entryBullish ? lastORB.entryPrice * ((100.0 - stopLossPercent) / 100.0) : lastORB.entryPrice * ((100.0 + stopLossPercent) / 100.0)
                center = (lastORB.h + lastORB.l) / 2.0
                if slMethod == 'Trend Candle'
                    lastORB.slPrice := na(lastORB.trendCandleLo) ? center : lastORB.entryBullish ? lastORB.trendCandleLo - syminfo.mintick * 2 : lastORB.trendCandleHi + syminfo.mintick * 2
                if slMethod == 'Safer'
                    lastORB.slPrice := lastORB.entryBullish ? (center + lastORB.h) / 2.0 : (center + lastORB.l) / 2.0
                if slMethod == 'Balanced'
                    lastORB.slPrice := center
                if slMethod == 'Risky'
                    lastORB.slPrice := lastORB.entryBullish ? (center + lastORB.l) / 2.0 : (center + lastORB.h) / 2.0

    if not na(lastORB) and na(lastORB.endIndex)
        if lastORB.state == 'Entry Taken' and bar_index > lastORB.entryIndex
            isProfitable = lastORB.entryBullish and ema > lastORB.entryPrice or not lastORB.entryBullish and ema < lastORB.entryPrice
            if tpMethod == 'Dynamic'
                if isProfitable and diffPercent(ema, lastORB.entryPrice) >= minimumProfitPercent
                    if na(lastORB.slIndex) and na(lastORB.tp1Index) and (lastORB.entryBullish and close < ema or not lastORB.entryBullish and close > ema)
                        lastORB.tp1Index := bar_index
                        lastORB.tp1Price := ema
                        lastORB.tp1FoundTick := true
                        if adaptiveSL
                            lastORB.slPrice := lastORB.entryPrice
                    else if na(lastORB.slIndex) and not na(lastORB.tp1Index) and na(lastORB.tp2Index) and (lastORB.entryBullish and close < ema or not lastORB.entryBullish and close > ema)
                        if (lastORB.entryBullish and ema > lastORB.tp1Price or not lastORB.entryBullish and ema < lastORB.tp1Price) and diffPercent(ema, lastORB.tp1Price) >= minimumProfitIncrementPercent
                            lastORB.tp2Index := bar_index
                            lastORB.tp2Price := ema
                            lastORB.tp2FoundTick := true
                    else if na(lastORB.slIndex) and not na(lastORB.tp2Index) and na(lastORB.tp3Index) and (lastORB.entryBullish and close < ema or not lastORB.entryBullish and close > ema)
                        if (lastORB.entryBullish and ema > lastORB.tp2Price or not lastORB.entryBullish and ema < lastORB.tp2Price) and diffPercent(ema, lastORB.tp2Price) >= minimumProfitIncrementPercent
                            lastORB.tp3Index := bar_index
                            lastORB.tp3Price := ema
                            lastORB.tp3FoundTick := true
                            lastORB.slIndex := -1
            if tpMethod == 'ATR'
                float tp1Price = lastORB.entryPrice + lastORB.entryATR * atrTP1Mult * atrTotalMult * (lastORB.entryBullish ? 1 : -1)
                float tp2Price = lastORB.entryPrice + lastORB.entryATR * atrTP2Mult * atrTotalMult * (lastORB.entryBullish ? 1 : -1)
                float tp3Price = lastORB.entryPrice + lastORB.entryATR * atrTP3Mult * atrTotalMult * (lastORB.entryBullish ? 1 : -1)
                if na(lastORB.slIndex) and na(lastORB.tp1Index) and (lastORB.entryBullish and high >= tp1Price or not lastORB.entryBullish and low <= tp1Price)
                    lastORB.tp1Index := bar_index
                    lastORB.tp1Price := tp1Price
                    lastORB.tp1FoundTick := true
                    if adaptiveSL
                        lastORB.slPrice := lastORB.entryPrice
                else if na(lastORB.slIndex) and not na(lastORB.tp1Index) and na(lastORB.tp2Index) and (lastORB.entryBullish and high >= tp2Price or not lastORB.entryBullish and low <= tp2Price)
                    lastORB.tp2Index := bar_index
                    lastORB.tp2Price := tp2Price
                    lastORB.tp2FoundTick := true
                else if na(lastORB.slIndex) and not na(lastORB.tp2Index) and na(lastORB.tp3Index) and (lastORB.entryBullish and high >= tp3Price or not lastORB.entryBullish and low <= tp3Price)
                    lastORB.tp3Index := bar_index
                    lastORB.tp3Price := tp3Price
                    lastORB.tp3FoundTick := true
                    lastORB.slIndex := -1
            if not na(lastORB.slPrice) and na(lastORB.slIndex) and (lastORB.entryBullish and low < lastORB.slPrice or not lastORB.entryBullish and high > lastORB.slPrice)
                if not(bar_index == lastORB.tp1Index or bar_index == lastORB.tp2Index or bar_index == lastORB.tp3Index)
                    lastORB.slFoundTick := true
                    lastORB.slIndex := bar_index

//#region Plots
isClose = bar_index > last_bar_index - renderMaxBarsBack
plotshape(na(lastORB) ? na : lastORB.tp1FoundTick and lastORB.entryBullish and isClose and (showHistoricZones or lastORB.isLastSession) ? close : na, 'TP 1', shape.xcross, size = size.tiny, text = 'TP 1', textcolor = color.white, location = location.abovebar)
plotshape(na(lastORB) ? na : lastORB.tp1FoundTick and not lastORB.entryBullish and isClose and (showHistoricZones or lastORB.isLastSession) ? close : na, 'TP 1', shape.xcross, size = size.tiny, text = 'TP 1', textcolor = color.white, location = location.belowbar)
plotshape(na(lastORB) ? na : lastORB.tp2FoundTick and lastORB.entryBullish and isClose and (showHistoricZones or lastORB.isLastSession) ? close : na, 'TP 2', shape.xcross, size = size.tiny, text = 'TP 2', textcolor = color.white, location = location.abovebar)
plotshape(na(lastORB) ? na : lastORB.tp2FoundTick and not lastORB.entryBullish and isClose and (showHistoricZones or lastORB.isLastSession) ? close : na, 'TP 2', shape.xcross, size = size.tiny, text = 'TP 2', textcolor = color.white, location = location.belowbar)
plotshape(na(lastORB) ? na : lastORB.tp3FoundTick and lastORB.entryBullish and isClose and (showHistoricZones or lastORB.isLastSession) ? close : na, 'TP 3', shape.xcross, size = size.tiny, text = 'TP 3', textcolor = color.white, location = location.abovebar)
plotshape(na(lastORB) ? na : lastORB.tp3FoundTick and not lastORB.entryBullish and isClose and (showHistoricZones or lastORB.isLastSession) ? close : na, 'TP 3', shape.xcross, size = size.tiny, text = 'TP 3', textcolor = color.white, location = location.belowbar)
plotshape(na(lastORB) ? na : lastORB.slFoundTick and lastORB.entryBullish and isClose and (showHistoricZones or lastORB.isLastSession) ? close : na, 'SL', shape.xcross, size = size.tiny, text = 'SL', color = color.red, textcolor = color.white, location = location.belowbar)
plotshape(na(lastORB) ? na : lastORB.slFoundTick and not lastORB.entryBullish and isClose and (showHistoricZones or lastORB.isLastSession) ? close : na, 'SL', shape.xcross, size = size.tiny, text = 'SL', color = color.red, textcolor = color.white, location = location.abovebar)
plotshape(na(previousORB) ? na : previousORB.exitTradeFoundTick and previousORB.entryBullish and isClose and (showHistoricZones or previousORB.isLastSession) ? close : na, 'Exit', shape.xcross, size = size.tiny, text = 'Exit', color = color.red, textcolor = color.white, location = location.belowbar, offset = -1)
plotshape(na(previousORB) ? na : previousORB.exitTradeFoundTick and not previousORB.entryBullish and isClose and (showHistoricZones or previousORB.isLastSession) ? close : na, 'Exit', shape.xcross, size = size.tiny, text = 'Exit', color = color.red, textcolor = color.white, location = location.abovebar, offset = -1)
// Entry markers — same X style as the SL/TP markers, on the bar the entry fired
plotshape(na(lastORB) ? na : lastORB.foundEntryTick and lastORB.entryBullish and isClose and (showHistoricZones or lastORB.isLastSession) ? close : na, 'Entry Buy', shape.xcross, size = size.tiny, text = 'Buy', color = color.green, textcolor = color.white, location = location.belowbar)
plotshape(na(lastORB) ? na : lastORB.foundEntryTick and not lastORB.entryBullish and isClose and (showHistoricZones or lastORB.isLastSession) ? close : na, 'Entry Sell', shape.xcross, size = size.tiny, text = 'Sell', color = color.red, textcolor = color.white, location = location.abovebar)
//#endregion Plots

// ── Real-time ENTRY detection ──
// Runs on every tick, exactly like the real-time SL/TP block below.
// 'Instant Level Break': fires the moment price touches the ORB level — no close needed.
// 'Retest of Level': a candle must first close beyond the level, then fires on the pullback touch.
// varip survives intrabar updates, so the alert fires exactly once per ORB session.
varip bool rtEntryFired = false
varip int rtEntryOrbStart = -1
bool rtEntryHit = false
bool rtEntryBullish = false
// Smart ORB entries are candle-close based by design (sweep + close back inside the
// value area, or close beyond it), so real-time touch entries are disabled with it on.
bool rtEntryEnabled = entryTrigger != 'Candle Close' and not smartOrbEnabled

if not na(lastORB) and lastORB.startIndex != rtEntryOrbStart
    rtEntryOrbStart := lastORB.startIndex
    rtEntryFired := false

if rtEntryEnabled and not na(lastORB) and na(lastORB.endIndex) and not rtEntryFired and isInAlertWindow
    bool rtVolOK = not useVolFilter or isHV
    if rtVolOK
        if entryTrigger == 'Instant Level Break' and lastORB.state == 'Waiting For Breakouts' and not na(lastORB.h)
            if high >= lastORB.h - tpSlBuffer
                rtEntryHit := true
                rtEntryBullish := true
                rtEntryFired := true
            else if low <= lastORB.l + tpSlBuffer
                rtEntryHit := true
                rtEntryBullish := false
                rtEntryFired := true
        if entryTrigger == 'Retest of Level' and lastORB.state == 'In Breakout'
            Breakout rtBreakout = lastORB.breakouts.get(0)
            if rtBreakout.isBullish and close > lastORB.h and low <= lastORB.h + tpSlBuffer
                rtEntryHit := true
                rtEntryBullish := true
                rtEntryFired := true
            if not rtBreakout.isBullish and close < lastORB.l and high >= lastORB.l - tpSlBuffer
                rtEntryHit := true
                rtEntryBullish := false
                rtEntryFired := true
// Confirmed entry with no real-time alert sent (e.g. on historical bars, or a Retest
// entry with no pullback under Sensitivity = High) — mark fired so the bar-close
// fallback below sends the alert exactly once.
bool rtEntryFallback = false
if rtEntryEnabled and not na(lastORB) and lastORB.foundEntryTick and not rtEntryFired
    rtEntryFallback := true
    rtEntryFired := true
// ─────────────────────────────────────────────────────────────────────────────

// ── PickMyTrade: hidden SL and TP1 plots for alert placeholders ──
var float pmtSL  = na
var float pmtTP1 = na
if not na(lastORB)
    if not na(lastORB.slPrice)
        pmtSL := lastORB.slPrice
    if not na(lastORB.tp1Price)
        pmtTP1 := lastORB.tp1Price
// At touch time the bar-close logic hasn't computed SL/TP yet, so fill the
// placeholders from the ORB range (and ATR targets) so the alert isn't stale.
if rtEntryHit
    float rtLevel  = rtEntryBullish ? lastORB.h : lastORB.l
    float rtCenter = (lastORB.h + lastORB.l) / 2.0
    float rtRangeSL = slMethod == 'Safer' ? (rtEntryBullish ? (rtCenter + lastORB.h) / 2.0 : (rtCenter + lastORB.l) / 2.0) : slMethod == 'Risky' ? (rtEntryBullish ? (rtCenter + lastORB.l) / 2.0 : (rtCenter + lastORB.h) / 2.0) : rtCenter
    pmtSL := slMethod == 'Trend Candle' ? (na(lastORB.trendCandleLo) ? rtCenter : rtEntryBullish ? lastORB.trendCandleLo - syminfo.mintick * 2 : lastORB.trendCandleHi + syminfo.mintick * 2) : rtRangeSL
    if tpMethod == 'ATR'
        pmtTP1 := rtLevel + atr * atrTP1Mult * atrTotalMult * (rtEntryBullish ? 1 : -1)
plot(pmtSL,  title = 'SL',   display = display.data_window, color = color.new(color.red,   100))
plot(pmtTP1, title = 'TP 1', display = display.data_window, color = color.new(color.green, 100))
// ────────────────────────────────────────────────────────────────

// ── Real-time TP/SL detection (fires immediately when price touches level) ──
// Entry signals fire per the 'Entry Trigger' input above;
// 'Candle Close' keeps the original bar-close behaviour (barstate.isconfirmed)
// TP and SL fire instantly on any tick so you exit at the right price
var bool rtTP1Fired = false
var bool rtTP2Fired = false
var bool rtTP3Fired = false
var bool rtSLFired  = false

// Reset real-time flags at the start of each new ORB entry
if not na(lastORB) and lastORB.foundEntryTick
    rtTP1Fired := false
    rtTP2Fired := false
    rtTP3Fired := false
    rtSLFired  := false

// Real-time TP/SL detection — runs on every tick including inside the bar
rtTP1Hit = false
rtTP2Hit = false
rtTP3Hit = false
rtSLHit  = false

if not na(lastORB) and lastORB.state == 'Entry Taken' and tpMethod == 'ATR' and isInAlertWindow
    float rt_tp1Price = lastORB.entryPrice + lastORB.entryATR * atrTP1Mult * atrTotalMult * (lastORB.entryBullish ? 1 : -1)
    float rt_tp2Price = lastORB.entryPrice + lastORB.entryATR * atrTP2Mult * atrTotalMult * (lastORB.entryBullish ? 1 : -1)
    float rt_tp3Price = lastORB.entryPrice + lastORB.entryATR * atrTP3Mult * atrTotalMult * (lastORB.entryBullish ? 1 : -1)

    if not rtTP1Fired and na(lastORB.slIndex)
        if lastORB.entryBullish and high >= rt_tp1Price - tpSlBuffer or not lastORB.entryBullish and low <= rt_tp1Price + tpSlBuffer
            rtTP1Hit  := true
            rtTP1Fired := true

    if rtTP1Fired and not rtTP2Fired and na(lastORB.slIndex)
        if lastORB.entryBullish and high >= rt_tp2Price - tpSlBuffer or not lastORB.entryBullish and low <= rt_tp2Price + tpSlBuffer
            rtTP2Hit  := true
            rtTP2Fired := true

    if rtTP2Fired and not rtTP3Fired and na(lastORB.slIndex)
        if lastORB.entryBullish and high >= rt_tp3Price - tpSlBuffer or not lastORB.entryBullish and low <= rt_tp3Price + tpSlBuffer
            rtTP3Hit  := true
            rtTP3Fired := true

    if not rtSLFired and not na(lastORB.slPrice) and na(lastORB.slIndex)
        if lastORB.entryBullish and low <= lastORB.slPrice + tpSlBuffer or not lastORB.entryBullish and high >= lastORB.slPrice - tpSlBuffer
            rtSLHit  := true
            rtSLFired := true
// ─────────────────────────────────────────────────────────────────────────────

foundEntryTick = false
foundBuyTick   = false
foundSellTick  = false
foundTP1Tick   = false
foundTP2Tick   = false
foundTP3Tick   = false
foundSLTick    = false

if not na(lastORB)
    if rtEntryEnabled
        if rtEntryHit
            foundEntryTick := true
            foundBuyTick   := rtEntryBullish
            foundSellTick  := not rtEntryBullish
        else if rtEntryFallback
            foundEntryTick := true
            foundBuyTick   := lastORB.entryBullish
            foundSellTick  := not lastORB.entryBullish
    else if lastORB.foundEntryTick
        foundEntryTick := true
        foundBuyTick   := lastORB.entryBullish
        foundSellTick  := not lastORB.entryBullish
    // For ATR mode use real-time hits; for Dynamic mode keep bar-close behaviour
    if tpMethod == 'ATR'
        if rtTP1Hit
            foundTP1Tick := true
        if rtTP2Hit
            foundTP2Tick := true
        if rtTP3Hit
            foundTP3Tick := true
        if rtSLHit
            foundSLTick := true
    else
        if lastORB.tp1FoundTick
            foundTP1Tick := true
        if lastORB.tp2FoundTick
            foundTP2Tick := true
        if lastORB.tp3FoundTick
            foundTP3Tick := true
        if lastORB.slFoundTick
            foundSLTick := true

alertcondition(foundEntryTick and isInAlertWindow, 'Buy / Sell')
alertcondition(foundBuyTick  and isInAlertWindow, 'Buy')
alertcondition(foundSellTick and isInAlertWindow, 'Sell')
alertcondition(foundTP1Tick  and isInAlertWindow, 'Take Profit 1')
alertcondition(foundTP2Tick  and isInAlertWindow, 'Take Profit 2')
alertcondition(foundTP3Tick  and isInAlertWindow, 'Take Profit 3')
alertcondition(foundSLTick   and isInAlertWindow, 'Stop Loss')

if barstate.islast
    if orbList.size() > 0
        for i = 0 to showHistoricZones ? orbList.size() - 1 : 0 by 1
            curORB = orbList.get(i)
            safeDeleteORB(curORB)
            renderORB(curORB)
    if showVP and volMap.size() > 0 and not na(lastORB)
        if vpBoxes.size() > 0
            for b in vpBoxes
                b.delete()
            vpBoxes.clear()
        float maxVol = 0.0
        float[] prices = volMap.keys()
        for p in prices
            maxVol := math.max(maxVol, volMap.get(p))
        if prices.size() > 0
            prices.sort()
            int profileMaxBars = 20
            float levelHeight = math.max(syminfo.mintick, (nz(lastORB.h, high) - nz(lastORB.l, low)) / vpRows)
            int startX = lastSessionBarIndex + 5
            for i = 0 to prices.size() - 1
                float p = prices.get(i)
                if p >= (lastORB.l - levelHeight / 2) and p <= (lastORB.h + levelHeight / 2)
                    float vol = volMap.get(p)
                    bool  isPOC = vol == maxVol
                    int bars = math.max(1, math.round((vol / math.max(1e-10, maxVol)) * profileMaxBars))
                    color cellColor = isPOC ? color.new(vpColor, 0) : color.new(vpColor, 40)
                    box nb = box.new(startX, p + levelHeight / 2, startX + bars, p - levelHeight / 2, border_color = color.new(vpColor, 100), bgcolor = cellColor)
                    vpBoxes.push(nb)

if barstate.islast and orbDisplayEnabled
    var table ORBDisplay = orbDisplayEnabled ? table.new(getPosition(orbLocation), 4, 5, bgcolor = orbColor, frame_width = 2, frame_color = color.black, border_width = 1, border_color = color.black) : na
    ORB lastORBD = na
    float foundEntryPrice = na
    bool isEntryBullish = false
    if orbList.size() > 0
        lastORBD := orbList.get(0)
        foundEntryPrice := lastORBD.entryPrice
        isEntryBullish := lastORBD.entryBullish
    table.merge_cells(ORBDisplay, 0, 0, 3, 0)
    table.cell(ORBDisplay, 0, 0, 'ORB Dashboard', text_color = color.white, bgcolor = orbColor)
    table.merge_cells(ORBDisplay, 0, 1, 0, 2)
    table.cell(ORBDisplay, 0, 1, na(foundEntryPrice) ? 'No Signal' : isEntryBullish ? 'Bullish' : 'Bearish', text_color = color.white, bgcolor = na(foundEntryPrice) ? orbColor : isEntryBullish ? color.green : color.red)
    table.cell(ORBDisplay, 1, 1, isEntryBullish ? 'Buy Price' : 'Sell Price', text_color = color.white, bgcolor = na(foundEntryPrice) ? orbColor : isEntryBullish ? #4caf50 : color.red)
    table.cell(ORBDisplay, 1, 2, na(foundEntryPrice) ? 'No Signal' : str.tostring(foundEntryPrice, format.mintick), text_color = color.white, bgcolor = na(foundEntryPrice) ? orbColor : isEntryBullish ? color.green : color.red)
    table.merge_cells(ORBDisplay, 2, 1, 3, 1)
    table.merge_cells(ORBDisplay, 2, 2, 3, 2)
    curProfit = close - foundEntryPrice
    if not isEntryBullish
        curProfit := curProfit * -1
    curProfitPercent = curProfit / foundEntryPrice * 100.0
    table.cell(ORBDisplay, 2, 1, 'Current Profit %', text_color = color.white, bgcolor = na(foundEntryPrice) ? orbColor : curProfit > 0 ? color.green : color.red)
    profitPercentText = na(curProfitPercent) ? 'No Signal' : str.tostring(curProfitPercent, '#.##') + '%'
    table.cell(ORBDisplay, 2, 2, profitPercentText, text_color = color.white, bgcolor = na(foundEntryPrice) ? orbColor : curProfit > 0 ? color.green : color.red)
    if not na(foundEntryPrice) and tpMethod == 'ATR'
        table.cell(ORBDisplay, 0, 3, 'TP 1', text_color = color.white)
        table.cell(ORBDisplay, 1, 3, 'TP 2', text_color = color.white)
        table.cell(ORBDisplay, 2, 3, 'TP 3', text_color = color.white)
        table.cell(ORBDisplay, 3, 3, 'SL', text_color = color.white)
        float tp1Price = lastORBD.entryPrice + lastORBD.entryATR * atrTP1Mult * atrTotalMult * (lastORBD.entryBullish ? 1 : -1)
        float tp2Price = lastORBD.entryPrice + lastORBD.entryATR * atrTP2Mult * atrTotalMult * (lastORBD.entryBullish ? 1 : -1)
        float tp3Price = lastORBD.entryPrice + lastORBD.entryATR * atrTP3Mult * atrTotalMult * (lastORBD.entryBullish ? 1 : -1)
        table.cell(ORBDisplay, 0, 4, str.tostring(tp1Price, format.mintick), text_color = color.white)
        table.cell(ORBDisplay, 1, 4, str.tostring(tp2Price, format.mintick), text_color = color.white)
        table.cell(ORBDisplay, 2, 4, str.tostring(tp3Price, format.mintick), text_color = color.white)
        table.cell(ORBDisplay, 3, 4, str.tostring(lastORBD.slPrice, format.mintick), text_color = color.white)
    else if not na(foundEntryPrice)
        table.merge_cells(ORBDisplay, 0, 3, 3, 3)
        table.merge_cells(ORBDisplay, 0, 4, 3, 4)
        table.cell(ORBDisplay, 0, 3, 'SL', text_color = color.white)
        table.cell(ORBDisplay, 0, 4, str.tostring(lastORBD.slPrice, format.mintick), text_color = color.white)

// ── Backtesting Dashboard ──
if barstate.islast and backtestDisplayEnabled
    // 15 rows: 0-6 main stats, 7 divider, 8-10 hit rates, 11 divider, 12-14 avg gains
    var table backtestDisplay = backtestDisplayEnabled ? table.new(getPosition(backtestingLocation), 2, 15, bgcolor = orbColor, frame_width = 2, frame_color = color.black, border_width = 1, border_color = color.black) : na
    float totalORBProfitPercent = 0
    int successfulTrades = 0
    int unsuccessfulTrades = 0
    int tp1Hits = 0
    int tp2Hits = 0
    int tp3Hits = 0
    int totalSignals = 0
    float tp1TotalProfit = 0.0
    float tp2TotalProfit = 0.0
    float tp3TotalProfit = 0.0

    if orbList.size() > 0
        for i = 0 to orbList.size() - 1 by 1
            curORB = orbList.get(i)
            if not na(curORB.entryIndex)
                totalSignals := totalSignals + 1
                isSuccess = false
                float totalProfitTaken = 0.0
                if not na(curORB.tp1Price)
                    isSuccess := true
                    tp1Hits := tp1Hits + 1
                    float tp1Gain = diffPercent(curORB.tp1Price, curORB.entryPrice)
                    tp1TotalProfit := tp1TotalProfit + tp1Gain
                    totalORBProfitPercent := totalORBProfitPercent + tp1Gain * backtestTP1Exit
                    totalProfitTaken := totalProfitTaken + backtestTP1Exit
                if not na(curORB.tp2Price)
                    isSuccess := true
                    tp2Hits := tp2Hits + 1
                    float tp2Gain = diffPercent(curORB.tp2Price, curORB.entryPrice)
                    tp2TotalProfit := tp2TotalProfit + tp2Gain
                    totalORBProfitPercent := totalORBProfitPercent + tp2Gain * backtestTP2Exit
                    totalProfitTaken := totalProfitTaken + backtestTP2Exit
                if not na(curORB.tp3Price)
                    isSuccess := true
                    tp3Hits := tp3Hits + 1
                    float tp3Gain = diffPercent(curORB.tp3Price, curORB.entryPrice)
                    tp3TotalProfit := tp3TotalProfit + tp3Gain
                    totalORBProfitPercent := totalORBProfitPercent + tp3Gain * backtestTP3Exit
                    totalProfitTaken := totalProfitTaken + backtestTP3Exit
                if not na(curORB.slIndex)
                    if curORB.slIndex != -1
                        totalORBProfitPercent := totalORBProfitPercent - diffPercent(curORB.slPrice, curORB.entryPrice) * (1.0 - totalProfitTaken)
                        if totalProfitTaken == 0.0
                            unsuccessfulTrades := unsuccessfulTrades + 1
                if isSuccess
                    successfulTrades := successfulTrades + 1

    float tp1AvgGain = tp1Hits > 0 ? tp1TotalProfit / tp1Hits : 0.0
    float tp2AvgGain = tp2Hits > 0 ? tp2TotalProfit / tp2Hits : 0.0
    float tp3AvgGain = tp3Hits > 0 ? tp3TotalProfit / tp3Hits : 0.0
    string bestTP = tp1AvgGain >= tp2AvgGain and tp1AvgGain >= tp3AvgGain ? 'TP 1' : tp2AvgGain >= tp1AvgGain and tp2AvgGain >= tp3AvgGain ? 'TP 2' : 'TP 3'

    // ── Main stats (rows 0-6) ──
    table.merge_cells(backtestDisplay, 0, 0, 1, 0)
    table.cell(backtestDisplay, 0, 0, 'ORB Backtesting', text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 0, 1, 'Total Signals', text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 1, 1, str.tostring(totalSignals), text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 0, 2, 'Wins', text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 1, 2, str.tostring(successfulTrades), text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 0, 3, 'Losses', text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 1, 3, str.tostring(unsuccessfulTrades), text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 0, 4, 'Winrate', text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 1, 4, str.tostring(100.0 * successfulTrades / math.max(1, successfulTrades + unsuccessfulTrades), '#.##') + '%', text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 0, 5, 'Avg Profit', text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 1, 5, str.tostring(totalORBProfitPercent / math.max(1, successfulTrades + unsuccessfulTrades), '#.##') + '%', text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 0, 6, 'Total Profit', text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 1, 6, str.tostring(totalORBProfitPercent, '#.##') + '%', text_color = color.white, bgcolor = orbColor)
    // ── TP Hit Rates (rows 7-10) ──
    table.merge_cells(backtestDisplay, 0, 7, 1, 7)
    table.cell(backtestDisplay, 0, 7, '── TP Hit Rates ──', text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 0, 8, 'TP 1 Hit Rate', text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 1, 8, str.tostring(100.0 * tp1Hits / math.max(1, totalSignals), '#.##') + '%  (' + str.tostring(tp1Hits) + '/' + str.tostring(totalSignals) + ')', text_color = color.white, bgcolor = tp1Hits > 0 ? color.new(color.green, 60) : orbColor)
    table.cell(backtestDisplay, 0, 9, 'TP 2 Hit Rate', text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 1, 9, str.tostring(100.0 * tp2Hits / math.max(1, totalSignals), '#.##') + '%  (' + str.tostring(tp2Hits) + '/' + str.tostring(totalSignals) + ')', text_color = color.white, bgcolor = tp2Hits > 0 ? color.new(color.green, 60) : orbColor)
    table.cell(backtestDisplay, 0, 10, 'TP 3 Hit Rate', text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 1, 10, str.tostring(100.0 * tp3Hits / math.max(1, totalSignals), '#.##') + '%  (' + str.tostring(tp3Hits) + '/' + str.tostring(totalSignals) + ')', text_color = color.white, bgcolor = tp3Hits > 0 ? color.new(color.green, 60) : orbColor)
    // ── Avg Gain per TP (rows 11-14) ──
    table.merge_cells(backtestDisplay, 0, 11, 1, 11)
    table.cell(backtestDisplay, 0, 11, '── Avg Gain per TP ──', text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 0, 12, 'TP 1 Avg Gain', text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 1, 12, str.tostring(tp1AvgGain, '#.###') + '%', text_color = color.white, bgcolor = bestTP == 'TP 1' ? color.new(color.yellow, 40) : orbColor)
    table.cell(backtestDisplay, 0, 13, 'TP 2 Avg Gain', text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 1, 13, str.tostring(tp2AvgGain, '#.###') + '%', text_color = color.white, bgcolor = bestTP == 'TP 2' ? color.new(color.yellow, 40) : orbColor)
    table.cell(backtestDisplay, 0, 14, 'TP 3 Avg Gain', text_color = color.white, bgcolor = orbColor)
    table.cell(backtestDisplay, 1, 14, str.tostring(tp3AvgGain, '#.###') + '%', text_color = color.white, bgcolor = bestTP == 'TP 3' ? color.new(color.yellow, 40) : orbColor)
